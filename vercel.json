{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/diagnose.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/models/champion-v1.json"]
      }
    },
    {
      "src": "api/training-samples.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/label-sample.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/training-dataset.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
